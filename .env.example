# Copy this file to .env and edit. All values are optional.

# Google sign-in: create an OAuth "Web application" client ID in Google Cloud Console
# and add http://localhost:8000 (and http://localhost:5173 for dev) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Supabase cloud database configuration:
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema from `supabase_schema.sql` in the Supabase SQL Editor
# 3. Paste your Project URL and API Key (service_role or anon key) below:
# (If left empty, PITWALL falls back to local SQLite storage in backend/pitwall.db)
SUPABASE_URL=
SUPABASE_KEY=

# Sessions are signed with this secret (auto-generated into backend/.jwt_secret if empty)
JWT_SECRET=

PORT=8000
